# Gur gateway ayarları — bu dosyayı .env olarak kopyalayıp doldurun. .env'i asla git'e eklemeyin.
BIND=127.0.0.1:8787
OPENROUTER_API_KEY=
# Gur 0.1 için OpenAI uyumlu uç (örn. https://ai.gurlabs.com/v1). Boşsa Gur 0.1 "Yakında" görünür.
GUR_API_BASE=
GUR_API_KEY=
APP_URL=https://gur.app
RATE_PER_MIN=20
MAX_INPUT_CHARS=120000
MODELS_PATH=/opt/gur/models.toml
RUST_LOG=info
